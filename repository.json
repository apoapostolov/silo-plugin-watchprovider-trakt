{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "community.watchprovider.trakt",
        "version": "0.3.0-community",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "darwin",
            "arch": "arm64"
          },
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "watch_sync_provider.v1",
            "id": "trakt",
            "display_name": "Trakt",
            "description": "Two-way watch history, resume progress, favorites, watchlist, movie and show ratings, and dropped shows, plus live scrobbling, for Trakt accounts.",
            "watch_sync_provider": {
              "auth_methods": [
                3
              ],
              "export_watched": true,
              "export_unwatched": true,
              "import_watched": true,
              "import_progress": true,
              "import_favorites": true,
              "export_favorites": true,
              "remove_favorites": true,
              "import_watchlist": true,
              "export_watchlist": true,
              "remove_watchlist": true,
              "scrobble_playback": true,
              "import_ratings": true,
              "export_ratings": true,
              "sync_dropped": true,
              "supported_media_types": [
                1,
                2,
                3
              ],
              "external_id_namespaces": [
                "imdb",
                "tmdb",
                "tvdb"
              ],
              "max_batch_size": 100
            }
          }
        ],
        "global_config_schema": [
          {
            "key": "app",
            "title": "Trakt API app",
            "description": "The Trakt API app this server signs in with. Every profile connection uses it.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"client_id\":{\"type\":\"string\"},\"client_secret\":{\"type\":\"string\"}},\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "submit_label": "Save Trakt app",
              "fields": [
                {
                  "key": "client_id",
                  "label": "Client ID",
                  "description": "Client ID of your Trakt API app.",
                  "control": 1,
                  "required": true
                },
                {
                  "key": "client_secret",
                  "label": "Client secret",
                  "description": "Client secret of your Trakt API app.",
                  "control": 3,
                  "required": true,
                  "secret": true
                }
              ]
            }
          }
        ],
        "category": "Watch Providers",
        "presentation": {
          "display_name": "Trakt Watch Provider",
          "summary": "Sync Silo watch activity, lists, ratings, and dropped shows with Trakt.",
          "description_markdown": "Imports watched movies and episodes, resume progress, favorites, the watchlist, movie and show ratings, and dropped shows from Trakt. Exports completed plays, unwatched titles, favorites, watchlist changes, ratings, and dropped shows, and forwards live playback start, pause, and stop events.",
          "setup_markdown": "Create an API app at [trakt.tv/oauth/applications](https://trakt.tv/oauth/applications) with the redirect URI `urn:ietf:wg:oauth:2.0:oob`, then enter its client ID and client secret below. Each Silo profile then connects its own Trakt account from its watch-provider settings by entering a code at trakt.tv/activate.",
          "homepage_url": "https://trakt.tv",
          "source_url": "https://github.com/apoapostolov/silo-plugin-watchprovider-trakt",
          "support_url": "https://github.com/apoapostolov/silo-plugin-watchprovider-trakt/issues",
          "changelog_url": "https://github.com/apoapostolov/silo-plugin-watchprovider-trakt/releases",
          "publisher_name": "Apostol Apostolov",
          "publisher_url": "https://github.com/Silo-Server",
          "license_spdx": "AGPL-3.0-only"
        }
      },
      "repo_url": "https://github.com/apoapostolov/silo-plugin-watchprovider-trakt",
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/apoapostolov/silo-plugin-watchprovider-trakt/releases/download/v0.3.0-community/plugin-linux-amd64",
          "checksum": "94475dadf9497a5c06d01964f6136e803d8e518f347e177d75ec8c5790f76f0d"
        },
        "linux/arm64": {
          "url": "https://github.com/apoapostolov/silo-plugin-watchprovider-trakt/releases/download/v0.3.0-community/plugin-linux-arm64",
          "checksum": "b39b76e328db71d055374c46927f87375599fbcc27e2047f2fc0fc2a0ca0719a"
        },
        "darwin/arm64": {
          "url": "https://github.com/apoapostolov/silo-plugin-watchprovider-trakt/releases/download/v0.3.0-community/plugin-darwin-arm64",
          "checksum": "9717044e81faa7bafc92ce1be8e5ee9907c3f92bf9447537fb3197e33b934ca6"
        }
      }
    }
  ]
}
